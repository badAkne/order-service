APP_ENV=local
APP_NAME=test
APP_LOGLEVEL=trace

APP_REPOSITORY_POSTGRES_HOST=postgres-order
APP_REPOSITORY_POSTGRES_PORT=5432
APP_REPOSITORY_POSTGRES_NAME=order_db
APP_REPOSITORY_POSTGRES_USERNAME=order
APP_REPOSITORY_POSTGRES_PASSWORD=secret
APP_REPOSITORY_POSTGRES_SSL_MODE=disable

APP_PROCESSOR_WEB_SERVER_HOST=0.0.0.0
APP_PROCESSOR_WEB_SERVER_LISTEN_PORT=8080
APP_PROCESSOR_WEB_SERVER_TIMEOUT=3s

APP_REPOSITORY_EXTERNAL_SERVICE_ONE_URL=https://service1.localhost.ru/
APP_REPOSITORY_EXTERNAL_SERVICE_TWO_URL=https://service2.localhost.ru/

APP_MONITOR_LOG_LEVEL=trace
APP_MONITOR_ENVIRONMENT=development
APP_MONITOR_TIME_FORMAT='2006-01-02 15:04:05'
APP_MONITOR_PROMETHEUS_ENABLED=true
APP_MONITOR_SENTRY_ENABLED=true
APP_MONITOR_SENTRY_DSN=https://ab5dcdb16d064d6ab73fa15dae18a06a@o4511263728140288.ingest.de.sentry.io/4511263730368592
APP_MONITOR_OPEN_TELEMETRY_ENABLED=true
APP_MONITOR_OPEN_TELEMETRY_ADDRESS=jaeger:4317
APP_MONITOR_OPEN_TELEMETRY_SAMPLE_RATIO=1
APP_MONITOR_OPEN_TELEMETRY_MAX_QUEUE_SIZE=256
APP_MONITOR_OPEN_TELEMETRY_MAX_BATCH_SIZE=32
APP_MONITOR_OPEN_TELEMETRY_SEND_BATCH_TIMEOUT=10ms
APP_MONITOR_OPEN_TELEMETRY_EXPORT_TIMEOUT=1s
APP_MONITOR_OPEN_TELEMETRY_ADD_REQUEST_HEADERS=true
APP_MONITOR_OPEN_TELEMETRY_ADD_REQUEST_BODY=true
APP_MONITOR_OPEN_TELEMETRY_ADD_RESPONSE_HEADERS=true
APP_MONITOR_OPEN_TELEMETRY_ADD_RESPONSE_BODY=true

# Kafka
APP_BROKER_KAFKA_ADDRESSES=kafka:9092
APP_BROKER_KAFKA_CONSUMER_GROUP=order-service
APP_BROKER_KAFKA_CLIENT_ID=order-service-1
APP_BROKER_KAFKA_MODEL_ORDER_CREATED_TOPIC=order.created
APP_BROKER_KAFKA_MODEL_ORDER_CREATED_CONSUMER_GROUP=
APP_BROKER_KAFKA_MODEL_ORDER_DELIVERY_CALCULATED_TOPIC=order.delivery.calculated

MIGRATION_DIR=./migration/postgres

CATALOG_SERVICE_GRPC_ADDR=catalog-service:50051